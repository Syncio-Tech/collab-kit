{
  "name": "collabkit-cli",
  "version": "0.4.3",
  "description": "Agent-agnostic conversation channel between a spec owner and an implementer, living in the spec repo.",
  "type": "module",
  "bin": {
    "collab": "dist/cli.js",
    "collabkit": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/cli.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "ai-agents",
    "spec",
    "collaboration",
    "cli",
    "github"
  ],
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Syncio-Tech/collab-kit.git"
  },
  "homepage": "https://github.com/Syncio-Tech/collab-kit#readme",
  "bugs": {
    "url": "https://github.com/Syncio-Tech/collab-kit/issues"
  }
}
